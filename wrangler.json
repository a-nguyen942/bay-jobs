{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bay-jobs",
  "preview_urls": false,
  "limits": {
    "cpu_ms": 500
  },
  "main": "worker/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bay-jobs-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "0-46 * * * *"
    ]
  },
  "dev": {
    "ip": "127.0.0.1"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
